   ]
  },
  "webtoon": {
   "refs": false,
   "cfg": {
    "turbo": 1.0,
    "full": 4.0
   },
   "steps": {
    "turbo": 8,
    "full": 30
   },
   "name": "anima",
   "label": "Anima (애니메이션 그림체, 글만 받아 인물·장소를 글로 맞춘다)",
   "model": "anima",
   "role": "vertical",
   "use_for": "선이 또렷한 애니메이션 그림체(UC 와 얼굴 모양이 많이 다르다). 글만 받아 얼굴 일관성이 약하다(참고 그림 없이 작품 설정의 생김새 글로 맞춘다): 전경·분위기 컷, 표지·키비주얼처럼 얼굴이 같을 필요가 적은 그림에 맞다. 판 데이터 prompt_template 이 품질·샷·인원 태그 머리말을 붙인다: 4컷 시험에서 한 명 컷이 한 명으로, 와이드의 좌우·소품이 글대로 나왔으나 클로즈업 하나는 중간 샷에 없는 노트북이 생겼고 간판에 글자 같은 무늬가 그려진다. refine 효과는 작다. 학습 크기가 약 100만 화소라 캔버스를 줄이고(max_pixels), '모든 그림에서 똑같이' 같은 여러 장을 뜻하는 말은 4분할로 그려서 prompt_drop 으로 뺀다. 라이선스: 모델 카드상 비상업(2026-10-19 조사, 상업 제품에 쓰기 전 확인).",
   "max_pixels": 1100000,
   "prompt_drop": [
    "(identical in every image)"
   ],
   "refine": {
    "method": "pixel",
    "scale": 1.3,
    "denoise": 0.25,
    "steps": 16,
    "note": "2차 다듬기 노드 넷은 우회 상태. 도구가 refine=True 로 부르면 켠다(꺼져 있으면 저장 노드가 첫 디코더로 이어진다). 값은 노드 위젯."
   },
   "prompt_template": {
    "prefix": "masterpiece, best quality, score_7, safe, anime coloring",
    "shot_tags": {
     "close-up": "close-up, portrait, face focus",
     "medium shot": "upper body, cowboy shot",
     "wide shot": "wide shot, scenery",
     "full shot": "full body",
     "insert shot": "close-up, detail, no humans"
    },
    "count_tags": {
     "0": "no humans",
     "1": "solo",
     "2": ""
    },
    "note": "글만 받는 판의 프롬프트 머리말. 모델 카드: 태그와 문장 혼용, 품질 태그 앞, 카메라 태그는 뒤. 샷 값은 comfy_panel.norm_shot 의 다섯 가지."
   }
  }
 },
 "version": 0.4
}